# Copy to .env (gitignored) on the server. docker compose reads it automatically.

# Signs auth/CSRF cookies. Generate with: openssl rand -hex 32
SECRET_KEY=

# Required to create the first event; disabled after that.
BOOTSTRAP_ADMIN_CODE=

# 1 only for a schema-changing redeploy (runs Alembic). Back up first.
RUN_MIGRATIONS=0

# Public hostname for Caddy. Before DNS is ready: breakouts.<ip-with-dashes>.sslip.io
SITE_ADDRESS=breakouts.example.com
BASE_URL=https://breakouts.example.com
COOKIE_SECURE=1

# Contact for push services (Web Push VAPID).
VAPID_SUBJECT=mailto:admin@example.com

# Compose profiles to run with the app on the server: caddy or tunnel.
COMPOSE_PROFILES=caddy
